runtimeEnv.__NatsuEnterUICallback = function()
	local setter = runtimeEnv.__NatsuIdentitySetter
	local identity = runtimeEnv.__NatsuUICapabilityIdentity
	if type(setter) == "function" and identity ~= nil then pcall(setter, identity) end
end

runtimeEnv.__NatsuRunUICallback = function(callback, ...)
	local getter = runtimeEnv.__NatsuIdentityGetter
	local setter = runtimeEnv.__NatsuIdentitySetter
	local previousIdentity
	if type(getter) == "function" then
		local ok, value = pcall(getter)
		if ok then previousIdentity = value end
	end
	local identity = runtimeEnv.__NatsuUICapabilityIdentity
	if type(setter) == "function" and identity ~= nil then pcall(setter, identity) end
	local results = table.pack(pcall(callback, ...))
	if type(setter) == "function" and previousIdentity ~= nil then
		pcall(setter, previousIdentity)
	end
	if not results[1] then error(results[2], 0) end
	return table.unpack(results, 2, results.n)
end

runtimeEnv.__NatsuWrapUICallback = function(callback)
	if type(callback) ~= "function" then return callback end
	return function(...)
		return runtimeEnv.__NatsuRunUICallback(callback, ...)
	end
end

runtimeEnv.__NatsuResolveUIHost = function()
	local cached = runtimeEnv.__NatsuUIHost
	if typeof(cached) == "Instance"
		and cached.Parent ~= nil
		and cached.Name ~= "RobloxGui"
	then
		local probe = Instance.new("Folder")
		probe.Name = "__NatsuCoreGuiProbe"
		local ok = pcall(function() probe.Parent = cached end)
		pcall(probe.Destroy, probe)
		if ok then return cached end
	end

	local candidates = {}
	local seen = {}
	local function addCandidate(candidate)
		if typeof(candidate) == "Instance"
			and candidate.Name ~= "RobloxGui"
			and not seen[candidate]
		then
			seen[candidate] = true
			table.insert(candidates, candidate)
		end
	end

	for _, getterName in ipairs({ "gethui", "get_hidden_gui", "gethiddengui" }) do
		local getter = runtimeEnv[getterName]
		if type(getter) == "function" then
			local ok, result = pcall(getter)
			if ok then addCandidate(result) end
		end
	end

	local okCore, coreResult = pcall(function()
		local coreGui = game:GetService("CoreGui")
		local clone = runtimeEnv.cloneref
		return type(clone) == "function" and clone(coreGui) or coreGui
	end)
	if okCore then addCandidate(coreResult) end

	local lastError = "CoreGui host unavailable"
	for _, candidate in ipairs(candidates) do
		local probe = Instance.new("Folder")
		probe.Name = "__NatsuCoreGuiProbe"
		local ok, err = pcall(function() probe.Parent = candidate end)
		pcall(probe.Destroy, probe)
		if ok then
			runtimeEnv.__NatsuUIHost = candidate
			return candidate
		end
		lastError = tostring(err)
	end

	runtimeEnv.__NatsuUIHost = nil
	return nil, lastError
end

runtimeEnv.__NatsuParentGui = function(gui)
	local host, err = runtimeEnv.__NatsuResolveUIHost()
	if not host or typeof(gui) ~= "Instance" then return false, err end
	local synApi = runtimeEnv.syn
	local protector = synApi and synApi.protect_gui or runtimeEnv.protect_gui
	if type(protector) == "function" then
		pcall(protector, gui)
	end
	local ok, parentErr = pcall(function() gui.Parent = host end)
	return ok, parentErr
end

do
	local host, err = runtimeEnv.__NatsuResolveUIHost()
